OPENAI_API_KEY=sk-your-key-here
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token
GENERATE_PAGE_IMAGES=false
DAILY_GENERATION_CAP=20
# Shared family passcode that gates story creation. Leave BLANK to keep creation
# open (fine for local dev). Set it in the deployment env to require the code
# before any story is generated — this protects your OpenAI bill from strangers
# with the link. Rotate by changing the value; devices with the old code re-enter.
CREATE_PASSCODE=

# Admin dashboard (content production tool). Admin is OFF unless ADMIN_PASSCODE is set.
# Use a STRONG value — 16+ random characters (e.g. `openssl rand -base64 24`).
ADMIN_PASSCODE=
# HMAC secret for the admin session cookie. If blank, ADMIN_PASSCODE is used as the secret.
# Recommended: set a distinct random value.
ADMIN_SESSION_SECRET=
